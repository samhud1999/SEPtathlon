# Postgres connection string. REQUIRED in production (Railway: add a Reference
# Variable DATABASE_URL=${{Postgres.DATABASE_URL}}). Leave empty locally to use
# the embedded PGlite database at ./data/creekos (zero-install dev).
DATABASE_URL=

# Commissioner PIN for /admin (PRD default: 2026)
ADMIN_PIN=2026

# Local dev port (Railway injects its own PORT)
PORT=8765
